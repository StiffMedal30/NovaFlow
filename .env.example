# Shared infrastructure
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me
DB_USERNAME=sa
DB_PASSWORD=change-me
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=change-me
RABBITMQ_USERNAME=novaflow
RABBITMQ_PASSWORD=change-me

# Application security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000
INTERNAL_SERVICE_KEY=replace-with-a-long-random-service-key
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8081

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_REFINEMENT_MODEL=gpt-5.2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=false
EMAIL_STARTTLS=false
EMAIL_FROM_ADDRESS=no-reply@novaflow.local
EMAIL_FROM_NAME=NovaFlow
