# Optional local fallback template.
# Prefer GitHub environment secrets for sensitive values and GitHub environment
# variables for non-sensitive values when running in GitHub Actions.

# Shared infrastructure
POSTGRES_USER=sa
POSTGRES_PASSWORD=change-me
# DB_* can be omitted when it should match POSTGRES_*.
DB_USERNAME=sa
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
USER_SERVICE_DB_NAME=user_service_db
IDEA_SERVICE_DB_NAME=idea_service_db
AI_SERVICE_DB_NAME=ai_service_db
USE_EXTERNAL_POSTGRES=0
PGADMIN_DEFAULT_EMAIL=admin@local.com
PGADMIN_DEFAULT_PASSWORD=change-me
RABBITMQ_USERNAME=novaflow
RABBITMQ_PASSWORD=change-me

# Application security
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=3600000
INTERNAL_SERVICE_KEY=replace-with-a-long-random-service-key
FRONTEND_BASE_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8081

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.2
OPENAI_REFINEMENT_MODEL=gpt-5.2
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Google OAuth
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SMTP_AUTH=false
EMAIL_STARTTLS=false
EMAIL_SSL_ENABLE=false
EMAIL_FROM_ADDRESS=no-reply@novaflow.local
EMAIL_FROM_NAME=NovaFlow

# Production CloudWatch logging
CLOUDWATCH_LOG_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/novaflow/production
CLOUDWATCH_LOG_CREATE_GROUP=true

# Production SSM Parameter Store env rendering
SSM_ENV_PATH=/novaflow/production/env
SSM_ENV_REGION=us-east-1
